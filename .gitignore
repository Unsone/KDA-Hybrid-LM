# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.uv-cache/

# Project datasets and generated artifacts
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/cache/*
!/data/cache/.gitkeep
/checkpoints/*
!/checkpoints/.gitkeep
/outputs/logs/*
!/outputs/logs/.gitkeep
/outputs/metrics/*
!/outputs/metrics/.gitkeep
/outputs/figures/*
!/outputs/figures/.gitkeep
/outputs/tables/*
!/outputs/tables/.gitkeep
/outputs/benchmarks/*
!/outputs/benchmarks/.gitkeep
